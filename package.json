{
  "name": "okiya-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build && tsx scripts/build-sw.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx scripts/simulate.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "e2e": "tsx scripts/e2e-flow.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "playwright": "^1.63.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource/shippori-mincho-b1": "^5.3.0",
    "@fontsource/zen-kaku-gothic-new": "^5.3.1"
  },
  "description": "Okiya, the two-player board game by Bruno Cathala and Cyril Bouquet, for phones, tablets and desktops."
}
